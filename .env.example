# Optional. Empty = embedded PGLite. Set for Neon / Postgres.
DATABASE_URL=

# Required in production. Preview generates a process-stable fallback.
BETTER_AUTH_SECRET=

# Public origin of the deployed app (no trailing slash).
BETTER_AUTH_URL=http://localhost:8080

# Optional. Enables the in-app song architect via the host AI key.
# XAI_API_KEY=
